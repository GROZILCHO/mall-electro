{
  "name": "mall-electro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "npx serve -s dist -l 5000",
    "preview:spa": "npx serve -s dist -l 5000",
    "preview:compressed": "node server/serve-compressed-simple.js 5000",
    "compress": "node scripts/compress-dist.js",
    "images:generate": "node scripts/convert-images.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^0.554.0",
    "mime": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "glob": "^9.3.5",
    "postcss": "^8.5.6",
    "sharp": "^0.32.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
