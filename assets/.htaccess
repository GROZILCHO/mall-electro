<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect old public routes to the new BG URL structure
  RewriteRule ^$ /bg/ [R=301,L]
  RewriteRule ^services/?$ /bg/uslugi/ [R=301,L]
  RewriteRule ^about/?$ /bg/za-nas/ [R=301,L]
  RewriteRule ^industries/?$ /bg/industrii/ [R=301,L]
  RewriteRule ^contact/?$ /bg/kontakti/ [R=301,L]

  # Do not rewrite existing files or directories
  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for React routes
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|webp|avif|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
