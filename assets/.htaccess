<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect old public routes to the new BG URL structure
  RewriteRule ^$ /bg/ [R=301,L]
  RewriteRule ^services/?$ /bg/uslugi/ [R=301,L]
  RewriteRule ^about/?$ /bg/za-nas/ [R=301,L]
  RewriteRule ^industries/?$ /bg/industrii/ [R=301,L]
  RewriteRule ^contact/?$ /bg/kontakti/ [R=301,L]

  # Prefer precompressed static assets when the client supports them
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+)\.(js|css|html|svg|txt|xml)$ $1.$2.br [L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)\.(js|css|html|svg|txt|xml)$ $1.$2.gz [L]

  # Do not rewrite existing files or directories
  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for React routes
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|webp|avif|woff2?)(\.(br|gz))?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)(\.(br|gz))?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.(xml|txt)(\.(br|gz))?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>

  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  RemoveType .br .gz

  AddType image/avif .avif
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/svg+xml .svg
  AddType text/css .css
  AddType application/javascript .js
  AddType text/html .html
  AddType text/plain .txt
  AddType application/xml .xml

  AddEncoding br .br
  AddEncoding gzip .gz
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
